# OPNsense API Settings
OPNSENSE_URL=https://opnsense.example.com

# Generate under System -> Access -> Users -> [user] -> API Keys
OPNSENSE_API_KEY=your_api_key_here
OPNSENSE_API_SECRET=your_api_secret_here

# Set to false to disable TLS certificate verification (e.g. self-signed cert)
OPNSENSE_VERIFY_SSL=true
